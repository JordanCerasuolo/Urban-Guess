# SQLite file (path relative to prisma/). No DB username/password.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"
COOKIE_NAME="access_token"
PORT=3000
# Same host/port as this server when serving the EJS UI from backend (default).
FRONTEND_ORIGIN="http://localhost:3000"

# Mapbox Static Images API (for prisma/mapbox:fetch — keep secret)
MAPBOX_ACCESS_TOKEN=""
