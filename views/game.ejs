<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Game</title>
<link rel="stylesheet" href="/stylesheets/style.css">

</head>

<body>

<section class="game-section">

<div class="game-topbar">
  <a href="/games" class="back-btn">&lt; BACK</a>

  <div class="guess-form">
    <input type="text" id="guessInput" placeholder="Guess the city..." class="guess-input" autocomplete="off">
    <button type="button" id="submitBtn" class="submit-btn">SUBMIT</button>
    <button type="button" id="giveUpBtn" class="submit-btn" style="margin-left:8px;">GIVE UP</button>
  </div>

  <span class="question-counter" id="gameTitle">Q1</span>
</div>

<p id="hintLine" class="hint-line" style="text-align:center;margin:0.5rem;"></p>

<div class="map-box">
  <img id="gameImage" src="/images/earth.jpg" alt="Satellite image">
</div>

<p id="endMessage" class="hint-line" style="text-align:center;" hidden></p>

</section>

<script src="/services/quizApi.js"></script>
<script src="/services/quizGame.js"></script>
</body>
</html>
