<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Games</title>
<link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

<section class="game-section">

<%- include('partials/head') %>

<h1 style="margin-top: 60px;">Choose a region</h1>

<div class="game-grid">

    <div class="game-card" data-continent="NORTH_AMERICA">
        <img src="/images/northamerica.jpeg" alt="North America">
        <div class="game-info">
            <h3>North America</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div> 

    <div class="game-card" data-continent="SOUTH_AMERICA">
        <img src="/images/southamerica.jpg" alt="South America">
        <div class="game-info">
            <h3>South America</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

    <div class="game-card" data-continent="EUROPE">
        <img src="/images/europe.jpg" alt="Europe">
        <div class="game-info">
            <h3>Europe</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

    <div class="game-card" data-continent="AFRICA">
        <img src="/images/africa.jpg" alt="Africa">
        <div class="game-info">
            <h3>Africa</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

    <div class="game-card" data-continent="ASIA">
        <img src="/images/asia.jpg" alt="Asia">
        <div class="game-info">
            <h3>Asia</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

    <div class="game-card" data-continent="OCEANIA">
        <img src="/images/oceania.jpg" alt="Oceania">
        <div class="game-info">
            <h3>Oceania</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

    <div class="game-card" data-continent="ANTARCTICA">
        <img src="/images/earth.jpg" alt="Antarctica">
        <div class="game-info">
            <h3>Antarctica</h3>
            <p>5 cities per run</p>
            <a href="#" class="js-play">PLAY</a>
        </div>
    </div>

</div>

</section>

<script src="/services/quizApi.js"></script>
<script src="/services/gamesPage.js"></script>
</body>
</html>
