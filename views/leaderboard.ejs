<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Leaderboard</title>
<link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

<section class="game-section">

<%- include('partials/head') %>

<h1 style="margin-top: 60px;">Leaderboards</h1>

<div class="leaderboard-container">

  <!-- Overall -->
  <div class="leaderboard-panel">
    <h2 class="leaderboard-title">Overall Leaderboard</h2>
    <section class="leaderboard">
      <div class="leaderboard-row leaderboard-header">
        <div class="rank">RANK</div>
        <div class="username">USERNAME</div>
        <div class="score">TOTAL SCORE</div>
      </div>
      <div id="leaderboardBody"></div>
    </section>
  </div>

  <!-- Monthly -->
  <div class="leaderboard-panel">
    <h2 class="leaderboard-title" id="monthlyTitle"></h2>
    <section class="leaderboard">
      <div class="leaderboard-row leaderboard-header">
        <div class="rank">RANK</div>
        <div class="username">USERNAME</div>
        <div class="score" id="monthlyScoreHeader">SCORE</div>
      </div>
      <div id="monthlyLeaderboardBody"></div>
    </section>
  </div>

</div>

</section>

<script src="/services/quizApi.js"></script>
<script src="/services/leaderboardPage.js"></script>
</body>
</html>
