<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Login</title>
<link rel="stylesheet" href="/stylesheets/style.css">

</head>
<body>

<div class="login-wrapper">
  <div class="login-box">
    <h2>Login</h2>
    
    <p id="formError" class="error-message"></p>

    <form id="loginForm">
      <input type="email" name="email" placeholder="Email" class="login-input" required autocomplete="username">
      <input type="password" name="password" placeholder="Password" class="login-input" required autocomplete="current-password">
      <button type="submit" class="login-btn">LOGIN</button>
    </form>

    <div class="login-footer">
      Don't have an account? <a href="/signup">Sign up</a>
    </div>
  </div>
</div>  

<script src="/services/quizApi.js"></script>
<script src="/services/loginPage.js"></script>
</body>
</html>
