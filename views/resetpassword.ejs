<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Reset Password</title>
<link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<%- include('partials/head') %>

<div class="login-wrapper">
  <div class="login-box">
    <h2>Reset Password</h2>

    <p id="formError" class="error-message"></p>
    <p id="formSuccess" class="success-message" style="display:none;"></p>

    <form id="resetPasswordForm">
      <input type="hidden" name="token" value="<%= token %>">
      <input type="password" name="password" placeholder="New password (min 8 characters)" class="login-input" required minlength="8" autocomplete="new-password">
      <input type="password" name="confirmPassword" placeholder="Confirm new password" class="login-input" required autocomplete="new-password">
      <button type="submit" class="login-btn">RESET PASSWORD</button>
    </form>

    <div class="login-footer">
      <a href="/login">Back to login</a>
    </div>
  </div>
</div>

<script src="/services/quizApi.js"></script>
<script src="/services/resetPasswordPage.js"></script>
</body>
</html>
