<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Sign Up</title>
<link rel="stylesheet" href="/stylesheets/style.css">

</head>
<body>

<div class="login-wrapper">
  <div class="login-box">
    <h2>Sign Up</h2>
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <form action="/signup" method="POST" onsubmit="return checkPasswords(event)">
      <input type="text" name="username" placeholder="Username" class="login-input" required>
      <input type="email" name="email" placeholder="Email" class="login-input" required>
      <input type="password" name="password" placeholder="Password" class="login-input" required>
      <input type="password" name="confirmPassword" placeholder="Confirm Password" class="login-input" required>

      <button class="login-btn" type="submit">CREATE ACCOUNT</button>      
    </form>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>
    
    <div class="divider"></div>

    <div class="login-footer">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>

<script>
  function checkPasswords(event) {
    const password = document.querySelector('[name="password"]').value;
    const confirm = document.querySelector('[name="confirmPassword"]').value;
    if (password !== confirm) {
      event.preventDefault();
      alert('Passwords do not match.');
      return false;
    }
  }
</script>

</body>
</html>
