<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Urban Guess - Sign Up</title>
<link rel="stylesheet" href="/stylesheets/style.css">

</head>
<body>

<div class="login-wrapper">
  <div class="login-box">
    <h2>Sign Up</h2>

    <input type="text" placeholder="Username" class="login-input">
    <input type="email" placeholder="Email" class="login-input">
    <input type="password" placeholder="Password" class="login-input">
    <input type="password" placeholder="Confirm Password" class="login-input">

    <button class="login-btn" onclick="window.location.href='/'">CREATE ACCOUNT</button>

    <div class="divider"></div>

    <div class="login-footer">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>

</body>
</html>
